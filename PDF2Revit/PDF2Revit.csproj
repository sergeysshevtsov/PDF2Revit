<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>true</ImplicitUsings>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Configurations>$(Configurations);Debug R23;Debug R24;Debug R25;Debug R26;</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('R21'))">
		<RevitVersion>2021</RevitVersion>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R22'))">
		<RevitVersion>2022</RevitVersion>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R23'))">
		<RevitVersion>2023</RevitVersion>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R24'))">
		<RevitVersion>2024</RevitVersion>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R25'))">
		<RevitVersion>2025</RevitVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R26'))">
		<RevitVersion>2026</RevitVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R27'))">
		<RevitVersion>2027</RevitVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
		<StartArguments>/language ENG</StartArguments>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Images\Ribbon\16_GenerateWalls.png" />
		<None Remove="Resources\Images\Ribbon\32_GenerateWalls.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitVersion).*" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="itext7" Version="9.6.0" />
	</ItemGroup>


	<ItemGroup>
		<None Update="PDF2Revit.addin">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<RevitDeployFiles Include="$(TargetPath)" />
		<RevitDeployFiles Include="@(ReferenceCopyLocalPaths)" />
		<RevitDeployFiles Include="@(RuntimeCopyLocalItems)" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\Images\Ribbon\16_GenerateWalls.png" />
		<Resource Include="Resources\Images\Ribbon\32_GenerateWalls.png" />
	</ItemGroup>

	<Target Name="CopyRevitAddin" AfterTargets="CopyFilesToOutputDirectory">
		<PropertyGroup>
			<RevitAddinsDir>$(AppData)\Autodesk\REVIT\Addins\$(RevitVersion)</RevitAddinsDir>
			<RevitAppDir>$(RevitAddinsDir)\PDF2Revit</RevitAppDir>
		</PropertyGroup>

		<ItemGroup>
			<RevitAddinFiles Include="$(ProjectDir)*.addin" />

			<!-- Главная DLL проекта -->
			<RevitDeployFiles Include="$(TargetPath)" />

			<!-- CopyLocal зависимости, кроме Revit DLL -->
			<RevitDeployFiles Include="@(ReferenceCopyLocalPaths)" Condition="&#xD;&#xA;				'%(ReferenceCopyLocalPaths.Filename)' != 'RevitAPI'&#xD;&#xA;				And '%(ReferenceCopyLocalPaths.Filename)' != 'RevitAPIUI'&#xD;&#xA;				And '%(ReferenceCopyLocalPaths.Filename)' != 'AdWindows'&#xD;&#xA;				And '%(ReferenceCopyLocalPaths.Filename)' != 'UIFramework'&#xD;&#xA;			" />

			<!-- Runtime зависимости .NET 8, кроме Revit DLL -->
			<RevitDeployFiles Include="@(RuntimeCopyLocalItems)" Condition="&#xD;&#xA;				'%(RuntimeCopyLocalItems.Filename)' != 'RevitAPI'&#xD;&#xA;				And '%(RuntimeCopyLocalItems.Filename)' != 'RevitAPIUI'&#xD;&#xA;				And '%(RuntimeCopyLocalItems.Filename)' != 'AdWindows'&#xD;&#xA;				And '%(RuntimeCopyLocalItems.Filename)' != 'UIFramework'&#xD;&#xA;			" />
		</ItemGroup>

		<MakeDir Directories="$(RevitAddinsDir)" />
		<MakeDir Directories="$(RevitAppDir)" />

		<Message Text="TARGET DIR = $(TargetDir)" Importance="high" />

		<Message Text="TARGET PATH = $(TargetPath)" Importance="high" />

		<Message Text="DEPLOY FILES = @(RevitDeployFiles)" Importance="high" />

		<Copy SourceFiles="@(RevitAddinFiles)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" />

		<Copy SourceFiles="@(RevitDeployFiles)" DestinationFolder="$(RevitAppDir)" SkipUnchangedFiles="true" />

	</Target>


</Project>
