<Window x:Class="PDF2Revit.UI.Views.WallPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF to Revit  |  Wall Review" Height="790" Width="1230" MinWidth="930" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="{DynamicResource WindowSurface}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/WindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,0,16">
            <TextBlock Text="Review detected walls" Style="{StaticResource DialogHeading}"/>
            <TextBlock Text="Confirm candidate walls and choose the PDF insertion anchor." Style="{StaticResource HelpText}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rotation" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RotationComboBox" Width="90" SelectionChanged="RotationChanged" SelectedIndex="0">
                        <ComboBoxItem Content="0°" Tag="0"/><ComboBoxItem Content="90°" Tag="90"/>
                        <ComboBoxItem Content="180°" Tag="180"/><ComboBoxItem Content="270°" Tag="270"/>
                    </ComboBox>
                    <Button x:Name="PickAnchorButton" Content="Pick anchor" Click="PickAnchorClick" Margin="14,0,0,0"/>
                    <TextBlock x:Name="AnchorInfo" VerticalAlignment="Center" Foreground="#64748B" Margin="12,0,14,0"/>
                </StackPanel>
                <TextBlock x:Name="Summary" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"
                           FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="10,8,10,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="−" ToolTip="Zoom out" Click="ZoomOutClick" Width="35" Padding="0"/>
                            <Button Content="+" ToolTip="Zoom in" Click="ZoomInClick" Width="35" Padding="0" Margin="6,0,0,0"/>
                            <Button Content="Fit" ToolTip="Fit drawing to initial size" Click="FitClick" Margin="6,0,0,0"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </StackPanel>
                        <TextBlock Text="Click: add  ·  Ctrl+click: remove  ·  Drag empty space: box select  ·  Ctrl+drag: remove"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                    </DockPanel>
                    <ScrollViewer x:Name="PreviewScroll" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="PreviewMouseWheel"
                                  PreviewMouseDown="PreviewMouseDown"
                                  PreviewMouseMove="PreviewMouseMove"
                                  PreviewMouseUp="PreviewMouseUp"
                                  LostMouseCapture="PreviewLostMouseCapture">
                        <Canvas x:Name="Drawing" Width="720" Height="720" Background="White" MouseLeftButtonDown="DrawingClick" MouseMove="DrawingMouseMove" MouseLeftButtonUp="DrawingMouseLeftButtonUp" LostMouseCapture="DrawingLostMouseCapture">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="DrawingZoomTransform" ScaleX="1" ScaleY="1"/>
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Wall candidates" FontWeight="SemiBold" FontSize="16" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ApprovedCount" HorizontalAlignment="Right" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Content="Select all" Click="SelectAllClick" Margin="0,0,8,0"/>
                        <Button Content="Clear all" Click="ClearAllClick" Margin="0,0,8,0"/>
                        <Button Content="Refresh" Click="RefreshClick"/>
                    </WrapPanel>
                    <DataGrid x:Name="WallGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionChanged="GridSelectionChanged" CurrentCellChanged="WallGridCurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Create" Binding="{Binding Approved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="68"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="56"/>
                            <DataGridTextColumn Header="Length (pt)" Binding="{Binding LengthPt, StringFormat=F1}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Gap (pt)" Binding="{Binding WidthPt, StringFormat=F1}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <CheckBox x:Name="UsePdfBackgroundCheckBox" DockPanel.Dock="Left" Content="Place source PDF as background in Revit"
                      VerticalAlignment="Center" Foreground="#334155" Margin="4,0,20,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="Create approved walls" Click="ConfirmClick" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
